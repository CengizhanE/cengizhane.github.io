<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title><? STR(global.title) ?></title>
		<meta property=      "og:title" content="<? STR(global.title) ?>"/>
		<meta name=       "description" content="<? STR(global.description) ?>"/>
		<meta property="og:description" content="<? STR(global.description) ?>"/>
		<link rel="alternate" type="application/rss+xml" title="rss feed" href="/rss.xml" />
        <link rel="icon" type="image/png" href="/favicon.png">
		<style>
        /* ENGINEERING THEME - TECHNICAL DARK */
        :root {
            --bg-color: #1a1b1e;       /* Deep Slate Grey (Like CAD software) */
            --text-main: #e6e6e6;      /* Off-white for readability */
            --text-muted: #a0a0a0;     /* Grey for less important text */
            --accent: #4da6ff;         /* "Simulation Blue" */
            --border: #333333;         /* Subtle borders */
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Segoe UI', Helvetica, Arial, sans-serif; /* Clean reading font */
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }

        /* The container that centers everything */
        .wrapper {
            max-width: 800px;     /* Not too wide, like a paper document */
            margin: 0 auto;       /* Centers it */
            padding: 40px 20px;
        }

        /* The Main Title - Uses a "Code" font for engineering feel */
        .home-title {
            font-family: 'Consolas', 'Courier New', monospace;
            color: var(--accent);
            font-size: 2.5rem;
            margin-bottom: 10px;
            border-bottom: 2px solid var(--border); /* A structural line under the title */
            padding-bottom: 15px;
        }

        .intro {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-bottom: 40px;
        }

        /* Links */
        a {
            color: var(--accent);
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
	</head>
	<body class="home">
		<div class="wrapper">
			<header>
				<h1 class="home-title"><? STR(global.title) ?></h1>
				<p class="intro"><? STR(global.description) ?></p>
			</header>

			<? CONTENT() ?>

			<? INCLUDE("footer") ?>
		</div>
	</body>
</html>
